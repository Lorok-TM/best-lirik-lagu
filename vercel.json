{
  "headers": [
    {
      "source": "/sitemap.rss",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/xml; charset=utf-8"
        }
      ]
    }
  ],
  
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/:slug(?!robots\\.txt|sitemap\\.xml|sitemap-news\\.xml|sitemap\\.rss|favicon\\.ico|favicon\\.svg|manifest\\.json|sw\\.js|dj-almira-berto\\.js|offline\\.html)",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/index.xml",
      "destination": "/sitemap.rss",
      "permanent": true
    }
  ]
  
}
