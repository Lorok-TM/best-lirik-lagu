{
  "headers": [
    {
      "source": "/sitemap.rss",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/xml; charset=utf-8"
        }
      ]
    }
  ],

  "redirects": [
    {
      "source": "/index.xml",
      "destination": "/sitemap.rss",
      "permanent": true
    },
    {
      "source": "/post/:slug",
      "destination": "/",
      "permanent": true
    }
  ] 

}
