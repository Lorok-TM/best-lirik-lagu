{
  "headers": [
    {
      "source": "/sitemap.rss",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/xml; charset=utf-8"
        }
      ]
    }
  ],
  "cleanUrls": true,
  "trailingSlash": true,
  "redirects": [
    {
      "source": "/index.xml",
      "destination": "/sitemap.rss",
      "permanent": true
    },
    {
      "source": "/404.html",
      "destination": "/",
      "permanent": true
    }
  ]
}
