{
  "headers": [
    {
      "source": "/sitemap.rss",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/xml; charset=utf-8"
        }
      ]
    }
  ],

  "cleanUrls": true,
  "redirects": [
    {
      "source": "/:slug((?!manifest\\.json|favicon\\.ico|robots\\.txt|sitemap\\.xml|.*\\.png|.*\\.jpg|.*\\.css|.*\\.js).*)",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/index.xml",
      "destination": "/sitemap.rss",
      "permanent": true
    }
  ] 

}
