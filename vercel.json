{
  "headers": [
    {
      "source": "/sitemap.rss",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/xml; charset=utf-8"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/index.xml",
      "destination": "/sitemap.rss",
      "permanent": true
    }
  ],
  "cleanUrls": true,
  "trailingSlash": true
}
