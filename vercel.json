{
  "headers": [
    {
      "source": "/sitemap.rss",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/xml; charset=utf-8"
        }
      ]
    }
  ],

  "redirects": [
    {
      "source": "/((?!^$|.*\\..*$).*)",
      "has": [
        {
          "type": "host",
          "value": "(?<host>.*)"
        }
      ],
      "missing": [
        {
          "type": "header",
          "key": "x-vercel-forwarded-for"
        }
      ],
      "destination": "/",
      "permanent": true
    }
  ]

}
