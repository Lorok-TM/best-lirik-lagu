{
  "cleanUrls": true,
  "trailingSlash": true,
    "redirects": [
    {
      "source": "/index.xml",
      "destination": "/sitemap.rss",
      "permanent": true
    },
    {
      "source": "/offline.html",
      "destination": "/offline.html",
      "permanent": true
    },
    {
      "source": "/offline/",
      "destination": "/offline.html",
      "permanent": true
    }
  ],
  "routes": [
    {
      "src": "/offline.html",
      "dest": "/offline.html",
      "continue": true
    },
    {
      "src": "/offline/",
      "dest": "/offline.html",
      "continue": true
    },
    {
      "src": "/sitemap.rss",
      "headers": {
        "Content-Type": "application/xml; charset=utf-8"
      },
      "continue": true
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "status": 301,
      "headers": {
        "Location": "/"
      }
    }
  ],
    "headers": [
    {
      "source": "/sitemap.rss",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/xml; charset=utf-8"
        }
      ]
    }
  ]
}
